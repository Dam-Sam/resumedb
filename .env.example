# Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://zcldficitrwsxlslwjbp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_XixpFzIPtvqKxYY8ObEttQ_j9q1llmz

# Claude (server only)
ANTHROPIC_API_KEY=
LLM_PROVIDER=claude

# Optional; defaults to claude-opus-5-5
LLM_MODEL=

# TypeSafe (Jev), classifies incoming job emails (server only)
TYPESAFE_API_KEY=

# Supabase service role (server only): email webhooks and cron run with nobody signed in
SUPABASE_SERVICE_ROLE_KEY=

# Encrypts stored inbox refresh tokens: openssl rand -base64 32
EMAIL_TOKEN_KEY=

# Gmail: Google Cloud OAuth client, Pub/Sub topic, and the push subscription's OIDC settings
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_PUBSUB_TOPIC=projects/<project-id>/topics/<topic>
GMAIL_PUSH_AUDIENCE=https://<your-domain>/api/email/gmail/push
GMAIL_PUSH_SERVICE_ACCOUNT=<name>@<project-id>.iam.gserviceaccount.com

# Vercel sends this to /api/email/renew (the daily cron)
CRON_SECRET=
