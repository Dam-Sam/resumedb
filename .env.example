# Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Claude (server only)
ANTHROPIC_API_KEY=
LLM_PROVIDER=claude

# Optional; defaults to claude-sonnet-5-5
LLM_MODEL=

# TypeSafe (Jev), classifies incoming job emails (server only)
TYPESAFE_API_KEY=

# Supabase service role (server only): email webhooks and cron run with nobody signed in
SUPABASE_SERVICE_ROLE_KEY=

# Encrypts stored inbox refresh tokens: openssl rand -base64 32
EMAIL_TOKEN_KEY=

# Gmail: Google Cloud OAuth client, Pub/Sub topic, and the push subscription's OIDC settings
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_PUBSUB_TOPIC=
GMAIL_PUSH_AUDIENCE=
GMAIL_PUSH_SERVICE_ACCOUNT=

# Vercel sends this to /api/email/renew (the daily cron)
CRON_SECRET=

# Dev only: enables /dev (sign in as seeded users). Never set on Vercel.
ENABLE_DEV_TOOLS=
